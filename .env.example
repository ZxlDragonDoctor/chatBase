# ChatBase 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# =============================================
# Java 应用配置
# =============================================
JAVA_OPTS=-Xms512m -Xmx2048m -XX:+UseG1GC

# =============================================
# MySQL 数据库配置
# =============================================
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_USER=chatbase
MYSQL_PASSWORD=your_password

# =============================================
# Redis 配置
# =============================================
REDIS_PASSWORD=

# =============================================
# Dify API 配置（必填）
# =============================================
DIFYAPP_API_KEY=your_dify_chat_api_key
DIFYAPP_DATASET_API_KEY=your_dify_dataset_api_key
DIFYAPP_DATASET_ID=

# =============================================
# QQ Bot 配置（可选）
# =============================================
QQ_BOT_ENABLE=false
QQ_BOT_ACCESS_TOKEN=
QQ_BOT_SELF_ID=
# NapCat OneBot HTTP 地址（容器网络内使用服务名 chatbase-napcat）
QQ_BOT_HTTP_BASE_URL=http://chatbase-napcat:3000
# NapCat WebUI 地址（后端代理扫码登录用，服务名 chatbase-napcat）
QQ_BOT_WEBUI_BASE_URL=http://chatbase-napcat:6099
# NapCat WebUI 鉴权 token（webui.json 中的 "token"）
QQ_BOT_WEBUI_TOKEN=

# NapCat Docker镜像版本
NAPCAT_IMAGE=mlikiowa/napcat-docker:v4.17.46

# =============================================
# 企业微信配置（可选）
# =============================================
WECHAT_CORP_STOKEN=
WECHAT_CORP_S_ENCODING_AES_KEY=
WECHAT_CORP_BOT_ID=
WECHAT_CORP_SECRET=

# =============================================
# 微信个人号 ilink 机器人配置（可选）
# =============================================
WX_BOT_ENABLE=false
WX_BOT_TOKEN=
WX_BOT_BASE_URL=
WX_BOT_BOT_ID=
WX_BOT_NICKNAME=微信机器人

# =============================================
# 本地 opencode 集成（可选）
# 新版 OpenClaw 式节点通道：管理员在私聊采集页生成一次性配对码，本机运行 opencode-node.mjs
#   电脑主动连接 /opencode/node，无需 frp / 内网穿透
# =============================================
OPENCODE_ENABLED=false

# 旧版 V1 直连 HTTP 回退地址（同机 / frp 隧道 / Tailscale）
# 容器内访问宿主机 frp 时用网关地址 172.17.0.1，不要用 127.0.0.1
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_PASSWORD=
OPENCODE_USERNAME=opencode
OPENCODE_DEFAULT_DIRECTORY=
OPENCODE_DEFAULT_AGENT=build
OPENCODE_DEFAULT_MODEL=opencode/mimo-v2.5-free
OPENCODE_TIMEOUT_SECONDS=300

# 本机 Node Agent（节点管理页生成一次性配对码）
OPENCODE_NODE_ENABLED=true
OPENCODE_NODE_TIMEOUT_SECONDS=320
OPENCODE_NODE_HEARTBEAT_SECONDS=30
OPENCODE_NODE_OFFLINE_AFTER_SECONDS=90
OPENCODE_NODE_PAIRING_TTL_SECONDS=600

# 旧版 V1 通用 HTTP 桥接（兼容已有部署）
OPENCODE_BRIDGE_ENABLED=true
# 桥接鉴权 token（自行生成随机串；与本机旧版 BRIDGE_TOKEN 保持一致）
OPENCODE_BRIDGE_TOKEN=
# auto=优先旧桥接并回退直连 | bridge=仅旧桥接 | direct=仅直连
OPENCODE_BRIDGE_TRANSPORT=auto

# =============================================
# CORS 白名单（逗号分隔；生产填正式域名）
# =============================================
# CORS_ALLOWED_ORIGINS=https://your-domain.example.com
