# ChatBase 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# =============================================
# Java 应用配置
# =============================================
JAVA_OPTS=-Xms512m -Xmx2048m -XX:+UseG1GC

# =============================================
# MySQL 数据库配置
# =============================================
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_USER=chatbase
MYSQL_PASSWORD=your_password

# =============================================
# Redis 配置
# =============================================
REDIS_PASSWORD=

# =============================================
# Dify API 配置（必填）
# =============================================
DIFYAPP_API_KEY=your_dify_chat_api_key
DIFYAPP_DATASET_API_KEY=your_dify_dataset_api_key
DIFYAPP_DATASET_ID=

# =============================================
# QQ Bot 配置（可选）
# =============================================
QQ_BOT_ENABLE=false
QQ_BOT_ACCESS_TOKEN=
QQ_BOT_SELF_ID=
# NapCat OneBot HTTP 地址（容器网络内使用服务名 chatbase-napcat）
QQ_BOT_HTTP_BASE_URL=http://chatbase-napcat:3000
# NapCat WebUI 地址（后端代理扫码登录用，服务名 chatbase-napcat）
QQ_BOT_WEBUI_BASE_URL=http://chatbase-napcat:6099
# NapCat WebUI 鉴权 token（webui.json 中的 "token"）
QQ_BOT_WEBUI_TOKEN=

# NapCat Docker镜像版本
NAPCAT_IMAGE=mlikiowa/napcat-docker:v4.17.46

# =============================================
# 企业微信配置（可选）
# =============================================
WECHAT_CORP_STOKEN=
WECHAT_CORP_S_ENCODING_AES_KEY=
WECHAT_CORP_BOT_ID=
WECHAT_CORP_SECRET=

# =============================================
# 微信个人号 ilink 机器人配置（可选）
# =============================================
WX_BOT_ENABLE=false
WX_BOT_TOKEN=
WX_BOT_BASE_URL=
WX_BOT_BOT_ID=
WX_BOT_NICKNAME=微信机器人

# =============================================
# 本地 opencode serve 集成配置（可选）
# 通过 frp 反向隧道访问运行在开发者本机的 opencode serve
# =============================================
OPENCODE_ENABLED=false
# 容器内访问宿主机的 frp 服务端，必须用网关地址 172.17.0.1（Docker bridge 默认网关），
# 不能用 127.0.0.1（容器内部回环）。端口为 frps 上映射的 remote_port（如 14096）。
# 仅本地开发（opencode 与后端同机）时才用 http://127.0.0.1:4096
OPENCODE_BASE_URL=http://172.17.0.1:14096
OPENCODE_PASSWORD=
OPENCODE_USERNAME=opencode
OPENCODE_DEFAULT_DIRECTORY=
OPENCODE_DEFAULT_AGENT=build
OPENCODE_TIMEOUT_SECONDS=300